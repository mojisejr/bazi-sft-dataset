OPEN_WEBUI_HOST_PORT=3001
OPENAI_API_BASE_URL=http://host.docker.internal:3000/api/v1
OPENAI_API_KEY=replace-with-open-webui-api-token
WEBUI_AUTH=True
ENABLE_FORWARD_USER_INFO_HEADERS=True
ENABLE_OAUTH_SIGNUP=True
OAUTH_CLIENT_ID=replace-with-clerk-oidc-client-id
OAUTH_CLIENT_SECRET=replace-with-clerk-oidc-client-secret
OPENID_PROVIDER_URL=https://your-clerk-instance/.well-known/openid-configuration
OAUTH_PROVIDER_NAME=Clerk