{
  "name": "bazi-sft-dataset",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "tsx scripts/generate-phase16-migration.ts && tsx scripts/verify-phase16-migration.ts",
    "db:migrate": "tsx scripts/check-phase16-db-state.ts && tsx scripts/apply-phase16-migration.ts",
    "db:migrate:safe": "tsx scripts/check-phase16-db-state.ts && tsx scripts/apply-phase16-migration.ts",
    "db:push": "tsx scripts/forbid-db-push.ts",
    "db:studio": "drizzle-kit studio",
    "db:check:phase16": "tsx scripts/check-phase16-db-state.ts",
    "db:seed:solar-terms": "tsx scripts/seed-time-solar-terms.ts",
    "db:seed:solar-terms:dry": "tsx scripts/seed-time-solar-terms.ts --dry-run",
    "db:seed:canonical": "tsx scripts/seed-canonical-knowledge.ts",
    "db:seed:canonical:dry": "tsx scripts/seed-canonical-knowledge.ts --dry-run",
    "db:seed:dataset-sample:dry": "tsx scripts/validate-phase16-sample.ts --dry-run",
    "db:seed:dataset-sample:write": "tsx scripts/validate-phase16-sample.ts --write",
    "dataset:export:sft": "tsx scripts/export-sft-dataset.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.0.12",
    "@neondatabase/serverless": "^1.0.2",
    "csv-parse": "^6.2.1",
    "drizzle-orm": "^0.45.2",
    "lunar-javascript": "^1.7.7",
    "next": "16.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
