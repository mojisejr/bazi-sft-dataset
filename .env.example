DATABASE_URL=postgresql://username:password@example.neon.tech/neondb?sslmode=require
GEMINI_API_KEY=your-gemini-api-key

# Supabase Storage (รูปไพ่โหมดเซียน) — สร้าง public bucket ชื่อ divine-cards
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DIVINE_BUCKET=divine-cards
# ── Louise Hay chat: rate limit / โควตา / เพดานค่าใช้จ่าย (in-memory) ──
# ปรับเพดานตามจำนวนผู้ใช้ (ดูตารางสเกลในเอกสาร) — แก้แล้ว redeploy
LH_RATE_PER_MIN=15        # burst ต่อนาที ต่อ IP
LH_DAILY_LIMIT=30         # โควตาต่อวัน ต่อ IP (free tier; คีย์ผู้ใช้เอง=ไม่จำกัด)
LH_DAILY_BUDGET_THB=100   # เพดานต้นทุนรวมต่อวัน (global) — ดันขึ้นตามจำนวนคน

# ── LINE alert (เตือนวันโชค/วันควรระวัง ผ่าน LINE push) ──
LINE_CHANNEL_ACCESS_TOKEN=your-messaging-api-channel-access-token  # ใช้ push ข้อความ (Messaging API)
LINE_CHANNEL_SECRET=your-messaging-api-channel-secret              # verify webhook signature
LINE_LOGIN_CHANNEL_ID=your-liff-login-channel-id                   # verify id_token จาก LIFF ก่อนตั้ง alert
CRON_SECRET=generate-a-long-random-string                         # ป้องกัน /api/cron/bazi-alerts (Vercel Cron แนบให้อัตโนมัติ)
NEXT_PUBLIC_LIFF_ID=your-liff-id                                  # LIFF ID ของหน้า louise-hay (frontend ใช้ getIDToken ตอนตั้ง alert)
